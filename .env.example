# ---------------------------------------------------------------------------
# Rede padrao de quem abre o app pela primeira vez: "devnet" ou "mainnet".
# Depois disso quem manda e o interruptor em Settings, guardado no navegador.
#
# O padrao e testnet DE PROPOSITO. Este app move dinheiro; esquecer de
# configurar deve custar zero, nunca dinheiro real. Valor nao reconhecido
# tambem cai em testnet.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NETWORK=devnet

# ---------------------------------------------------------------------------
# RPCs. Todos opcionais — sem eles o app usa os publicos, que tem rate limit
# baixo e recusam em horario de pico.
#
# Uma chave da Alchemy serve pra todas as redes; o que muda e o subdominio.
# O plano gratuito deles inclui acesso a dados de archive, que sera necessario
# quando a direcao Base -> Solana existir: a prova exige ler o estado de um
# bloco de ~15 minutos atras, e RPC comum so guarda os ultimos ~128 blocos.
# ---------------------------------------------------------------------------
# https://eth-mainnet.g.alchemy.com/v2/SUA_CHAVE
NEXT_PUBLIC_RPC_MAINNET=

# https://base-mainnet.g.alchemy.com/v2/SUA_CHAVE
NEXT_PUBLIC_RPC_BASE=

# https://base-sepolia.g.alchemy.com/v2/SUA_CHAVE
NEXT_PUBLIC_RPC_BASE_SEPOLIA=

# https://solana-mainnet.g.alchemy.com/v2/SUA_CHAVE
NEXT_PUBLIC_SOLANA_RPC=

# ---------------------------------------------------------------------------
# WalletConnect. Opcional: sem isso o app funciona com carteiras injetadas
# (MetaMask, Rabby, Brave) e Coinbase Wallet. Com um projectId gratuito de
# cloud.reown.com, entram tambem as carteiras mobile por QR code.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_WC_PROJECT_ID=
