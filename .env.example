# Rede: "devnet" ou "mainnet".
# O padrao e devnet DE PROPOSITO. Este app move dinheiro, entao esquecer de
# configurar deve resultar numa transferencia de teste que nao custa nada, nunca
# numa na mainnet. Qualquer valor nao reconhecido tambem cai em devnet.
NEXT_PUBLIC_NETWORK=devnet

# Opcional. Sem isso o app funciona com carteiras injetadas (MetaMask, Rabby) e Coinbase Wallet.
# Com um projectId (gratuito em https://cloud.reown.com) o WalletConnect entra na lista,
# habilitando carteiras mobile via QR code.
NEXT_PUBLIC_WC_PROJECT_ID=

# Opcional. Sem isso usa o RPC publico padrao do viem, que tem rate limit baixo.
NEXT_PUBLIC_RPC_MAINNET=
NEXT_PUBLIC_RPC_BASE=

# Opcional. Sem isso usa o RPC publico da Solana, que tem rate limit agressivo
# e costuma recusar em horario de pico. Helius ou QuickNode resolvem.
NEXT_PUBLIC_SOLANA_RPC=
